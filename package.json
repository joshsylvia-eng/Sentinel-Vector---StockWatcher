{
  "name": "sentinel-vector-stockwatcher",
  "productName": "Sentinel Vector - StockWatcher",
  "version": "1.0.0",
  "description": "Stock watchlist with live prices and technical analysis ratings",
  "main": "src/main/main.js",
  "private": true,
  "author": "Sentinel Vector",
  "scripts": {
    "start": "electron .",
    "test:data": "node tools/test-data.js",
    "icon": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/make-icon.ps1",
    "build": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.sentinelvector.stockwatcher",
    "productName": "Sentinel Vector - StockWatcher",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "SentinelVector-StockWatcher.exe"
    }
  }
}
